                <Param name="Begin Routine" val="win.mouseVisible=False&#10;time_now=datetime.datetime.now()&#10;letterSelected=False&#10;# If there haven't been n letters yet, subject should not respond&#10;if len(presentedLetters) &lt; n:&#10;    Correct='None'&#10;    thisLetter = np.random.choice(letters)&#10;    if (practice==True):&#10;        outlet.push_sample([f&quot;PracNonTarget-{n}&quot;],timestamp=local_clock()+fixation_time+blank_time)&#10;    else:&#10;        outlet.push_sample([f&quot;NonTarget-{n}&quot;],timestamp=local_clock()+fixation_time+blank_time)&#10;else:&#10;    Correct=CorrectResponse&#10;    # Check whether letter is Target or not and sample a letter that matches the criteria&#10;    if TargetTrial==0:&#10;        if (practice==True):&#10;            outlet.push_sample([f&quot;PracNonTarget-{n}&quot;],timestamp=local_clock()+fixation_time+blank_time)&#10;        else:&#10;            outlet.push_sample([f&quot;NonTarget-{n}&quot;],timestamp=local_clock()+fixation_time+blank_time)&#10;        tmp=letters.copy()&#10;        tmp.remove(presentedLetters[-n]) # remove the letter that would be a target from the set&#10;        thisLetter = np.random.choice(tmp)# if this is not a target then randomly choose one of the remaining letters&#10;    else:&#10;        if (practice==True):&#10;            outlet.push_sample([f&quot;PracTarget-{n}&quot;],timestamp=local_clock()+fixation_time+blank_time)&#10;        else:&#10;            outlet.push_sample([f&quot;Target-{n}&quot;],timestamp=local_clock()+fixation_time+blank_time)&#10;        thisLetter = presentedLetters[-n]# if this was a target choose the n'th back&#10;&#10;presentedLetters.append(thisLetter)&#10;&#10;thisExp.addData('Letter', thisLetter)&#10;thisExp.addData(&quot;Time&quot;, globalClock.getTime())" valType="extendedCode" updates="constant" plugin="None"/>
