                <Param name="Begin JS Routine" val="letterSelected = false;&#10;time_now = datetime.datetime.now();&#10;if ((presentedLetters.length &lt; n_prac)) {&#10;    Correct = &quot;None&quot;;&#10;    thisLetter = np.random.choice(letters);&#10;    outlet.push_sample([`PracNonTarget-${n_prac}`], {&quot;timestamp&quot;: (local_clock() + 0.75)});&#10;} else {&#10;    Correct = CorrectResponse;&#10;    if ((TargetTrial === 0)) {&#10;        outlet.push_sample([`PracNonTarget-${n_prac}`], {&quot;timestamp&quot;: (local_clock() + 0.75)});&#10;        tmp = letters.copy();&#10;        tmp.remove(presentedLetters.slice((- n_prac))[0]);&#10;        thisLetter = np.random.choice(tmp);&#10;    } else {&#10;        outlet.push_sample([`PracTarget-${n_prac}`], {&quot;timestamp&quot;: (local_clock() + 0.75)});&#10;        thisLetter = presentedLetters.slice((- n_prac))[0];&#10;    }&#10;}&#10;presentedLetters.push(thisLetter);&#10;psychoJS.experiment.addData(&quot;Letter&quot;, thisLetter);&#10;psychoJS.window.mouseVisible = false;&#10;psychoJS.experiment.addData(&quot;Time&quot;, globalClock.getTime());&#10;" valType="extendedCode" updates="constant" plugin="None"/>
