                <Param name="Begin Routine" val="letterSelected=False&#10;time_now=datetime.datetime.now()&#10;&#10;# If there haven't been n letters yet, subject should not respond&#10;if len(presentedLetters) &lt; n_prac:&#10;    Correct='None'&#10;    thisLetter = np.random.choice(letters)&#10;    outlet.push_sample([f&quot;PracNonTarget-{n_prac}&quot;],timestamp=local_clock()+.75)&#10;else:&#10;    Correct=CorrectResponse&#10;    # Check whether letter is Target or not and sample a letter that matches the criteria&#10;    if TargetTrial==0:&#10;        outlet.push_sample([f&quot;PracNonTarget-{n_prac}&quot;],timestamp=local_clock()+.75)&#10;        tmp=letters.copy()&#10;        tmp.remove(presentedLetters[-n_prac]) # remove the letter that would be a target from the set&#10;        thisLetter = np.random.choice(tmp)# if this is not a target then randomly choose one of the remaining letters&#10;    else:&#10;        outlet.push_sample([f&quot;PracTarget-{n_prac}&quot;],timestamp=local_clock()+.75)&#10;        thisLetter = presentedLetters[-n_prac]# if this was a target choose the n'th back&#10;&#10;#audio_file=&quot;Audio\%s.wav&quot; %thisLetter&#10;presentedLetters.append(thisLetter)&#10;&#10;thisExp.addData('Letter', thisLetter)&#10;win.mouseVisible=False&#10;thisExp.addData(&quot;Time&quot;, globalClock.getTime())" valType="extendedCode" updates="constant" plugin="None"/>
