            <CodeComponent name="code_8" plugin="None">
                <Param name="name" val="code_8" valType="code" updates="None" plugin="None"/>
                <Param name="Code Type" val="Auto-&gt;JS" valType="str" updates="None" plugin="None"/>
                <Param name="disabled" val="False" valType="bool" updates="None" plugin="None"/>
                <Param name="Before Experiment" val="" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="Begin Experiment" val="" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="Begin Routine" val="if &quot;Practice&quot; not in Stimulus:&#10;    if not trials.thisN == (break_after-1):&#10;        continueRoutine=False" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="Each Frame" val="" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="End Routine" val="if ser.in_waiting:&#10;    tmp = ser.readline().decode(&quot;utf-8&quot;)[:-1] # Exclude first three chars and last carriage return, just to clean it up for file&#10;    if tmp[0:3]==&quot;dta&quot;:&#10;        nextontime = (time.perf_counter_ns()-initial_timestamp) // 1000000 # Onset of next trial comes immediately after datline&#10;        extracted_data = tmp.replace('dta&gt;DRT, SFT,', '').split(',')&#10;        onset = int(extracted_data[0].strip())&#10;        offset = int(extracted_data[1].strip())&#10;        unix = int(extracted_data[2].strip())&#10;        trial = int(extracted_data[3].strip())&#10;        stim = extracted_data[4].strip()&#10;        rt = int(extracted_data[5].strip())&#10;        clicks = int(extracted_data[6].strip())&#10;        isi = int(extracted_data[7].strip())&#10;        lag=ontime - onset&#10;        outlet.push_sample([stim],timestamp=local_clock()-(local_clock()-(onset-lag)*1000))&#10;        dat.write(str(ontime) +  ',' + str(onset) + ',' + str(offset) + ',' + str(unix) + ',' + str(trial) + ',' + str(stim) + ',' + str(rt) + ',' + str(clicks) + ',' + str(isi) + ',' + str(Block) + ','  + expInfo['participant'] + ',' + str(lag) + '\n' )&#10;        ontime = nextontime&#10;    if tmp[0:3]==&quot;tim&quot;:&#10;        board_time = int(tmp.split(&quot;&gt;&quot;)[1].split(&quot;,&quot;)[0].strip())  # Extract DRT-reported time&#10;        pc_time = (time.perf_counter_ns() - initial_timestamp) // 1000000  # Convert to ms&#10;        drift = pc_time - board_time  # Compare PC vs. DRT time&#10;        print(f'DRT time: {board_time} ms, PC time: {pc_time} ms, Drift: {drift} ms')&#10;" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="End Experiment" val="" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="Before JS Experiment" val="" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="Begin JS Experiment" val="" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="Begin JS Routine" val="var _pj;&#10;function _pj_snippets(container) {&#10;    function in_es6(left, right) {&#10;        if (((right instanceof Array) || ((typeof right) === &quot;string&quot;))) {&#10;            return (right.indexOf(left) &gt; (- 1));&#10;        } else {&#10;            if (((right instanceof Map) || (right instanceof Set) || (right instanceof WeakMap) || (right instanceof WeakSet))) {&#10;                return right.has(left);&#10;            } else {&#10;                return (left in right);&#10;            }&#10;        }&#10;    }&#10;    container[&quot;in_es6&quot;] = in_es6;&#10;    return container;&#10;}&#10;_pj = {};&#10;_pj_snippets(_pj);&#10;if ((! _pj.in_es6(&quot;Practice&quot;, Stimulus))) {&#10;    if ((! (trials.thisN === (break_after - 1)))) {&#10;        continueRoutine = false;&#10;    }&#10;}&#10;" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="Each JS Frame" val="" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="End JS Routine" val="// Error in Python code" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="End JS Experiment" val="" valType="extendedCode" updates="constant" plugin="None"/>
            </CodeComponent>
        </Routine>
