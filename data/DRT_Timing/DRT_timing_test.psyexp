        <Routine name="MarkersAndCoding">
            <RoutineSettingsComponent name="MarkersAndCoding" plugin="None">
                <Param name="name" val="MarkersAndCoding" valType="code" updates="None" plugin="None"/>
                <Param name="stopVal" val="" valType="code" updates="constant" plugin="None"/>
                <Param name="durationEstim" val="" valType="code" updates="None" plugin="None"/>
                <Param name="stopType" val="duration (s)" valType="str" updates="None" plugin="None"/>
                <Param name="forceNonSlip" val="False" valType="code" updates="None" plugin="None"/>
                <Param name="skipIf" val="" valType="code" updates="constant" plugin="None"/>
                <Param name="useWindowParams" val="False" valType="bool" updates="None" plugin="None"/>
                <Param name="color" val="$[0,0,0]" valType="color" updates="None" plugin="None"/>
                <Param name="colorSpace" val="rgb" valType="str" updates="None" plugin="None"/>
                <Param name="backgroundImg" val="" valType="str" updates="None" plugin="None"/>
                <Param name="backgroundFit" val="none" valType="str" updates="None" plugin="None"/>
                <Param name="saveStartStop" val="True" valType="bool" updates="None" plugin="None"/>
                <Param name="disabled" val="False" valType="bool" updates="None" plugin="None"/>
                <Param name="desc" val="" valType="str" updates="constant" plugin="None"/>
            </RoutineSettingsComponent>
            <CodeComponent name="code_16" plugin="None">
                <Param name="name" val="code_16" valType="code" updates="None" plugin="None"/>
                <Param name="Code Type" val="Auto-&gt;JS" valType="str" updates="None" plugin="None"/>
                <Param name="disabled" val="False" valType="bool" updates="None" plugin="None"/>
                <Param name="Before Experiment" val="" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="Begin Experiment" val="" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="Begin Routine" val="if (practice==True):&#10;    thisExp.addData('Block', Block)&#10;    thisExp.addData('Time', time_now)&#10;    thisExp.addData('CorrectResp_adj', Correct)&#10;    if (Block==&quot;Practice1&quot;):&#10;        thisExp.addData('Correct', practice_resp.corr)&#10;        if (len(presentedLetters)&gt;n_prac and TargetTrial==1 and practice_resp.corr==1):&#10;            outlet.push_sample([f&quot;PracTargetResponse-{n_prac}&quot;],timestamp=local_clock()+fixation_time+blank_time+practice_resp.rt)&#10;    else:&#10;        thisExp.addData('Correct', key_resp.corr)&#10;        if (len(presentedLetters)&gt;n and TargetTrial==1 and key_resp.corr==1):&#10;            outlet.push_sample([f&quot;PracTargetResponse-{n}&quot;],timestamp=local_clock()+fixation_time+blank_time+key_resp.rt)&#10;    &#10;else:&#10;    # If a response is made to a target, push a marker&#10;    # NB no point for non-targets as it's a witheld response, and we probably don't care about false alarms&#10;    if (len(presentedLetters)&gt;n and TargetTrial==1 and key_resp.corr==1):&#10;            outlet.push_sample([f&quot;TargetResponse-{n}&quot;],timestamp=local_clock()+fixation_time+blank_time+key_resp.rt)&#10;    thisExp.addData('Block', Block)&#10;    thisExp.addData('Correct', key_resp.corr)&#10;    thisExp.addData('Time', time_now)&#10;    thisExp.addData('CorrectResp_adj', Correct)" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="Each Frame" val="" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="End Routine" val="" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="End Experiment" val="" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="Before JS Experiment" val="" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="Begin JS Experiment" val="" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="Begin JS Routine" val="if ((practice === true)) {&#10;    psychoJS.experiment.addData(&quot;Block&quot;, Block);&#10;    psychoJS.experiment.addData(&quot;Time&quot;, time_now);&#10;    psychoJS.experiment.addData(&quot;CorrectResp_adj&quot;, Correct);&#10;    if ((Block === &quot;Practice1&quot;)) {&#10;        psychoJS.experiment.addData(&quot;Correct&quot;, practice_resp.corr);&#10;        if ((((presentedLetters.length &gt; n_prac) &amp;&amp; (TargetTrial === 1)) &amp;&amp; (practice_resp.corr === 1))) {&#10;            outlet.push_sample([`PracTargetResponse-${n_prac}`], {&quot;timestamp&quot;: (((local_clock() + fixation_time) + blank_time) + practice_resp.rt)});&#10;        }&#10;    } else {&#10;        psychoJS.experiment.addData(&quot;Correct&quot;, key_resp.corr);&#10;        if ((((presentedLetters.length &gt; n) &amp;&amp; (TargetTrial === 1)) &amp;&amp; (key_resp.corr === 1))) {&#10;            outlet.push_sample([`PracTargetResponse-${n}`], {&quot;timestamp&quot;: (((local_clock() + fixation_time) + blank_time) + key_resp.rt)});&#10;        }&#10;    }&#10;} else {&#10;    if ((((presentedLetters.length &gt; n) &amp;&amp; (TargetTrial === 1)) &amp;&amp; (key_resp.corr === 1))) {&#10;        outlet.push_sample([`TargetResponse-${n}`], {&quot;timestamp&quot;: (((local_clock() + fixation_time) + blank_time) + key_resp.rt)});&#10;    }&#10;    psychoJS.experiment.addData(&quot;Block&quot;, Block);&#10;    psychoJS.experiment.addData(&quot;Correct&quot;, key_resp.corr);&#10;    psychoJS.experiment.addData(&quot;Time&quot;, time_now);&#10;    psychoJS.experiment.addData(&quot;CorrectResp_adj&quot;, Correct);&#10;}&#10;" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="Each JS Frame" val="" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="End JS Routine" val="" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="End JS Experiment" val="" valType="extendedCode" updates="constant" plugin="None"/>
            </CodeComponent>
        </Routine>
    </Routines>
