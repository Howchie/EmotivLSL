                <Param name="contrast" val="1" valType="num" updates="constant" plugin="None"/>
                <Param name="validator" val="" valType="code" updates="None" plugin="None"/>
                <Param name="text" val="Welcome! Thank you for participating in this experiment.&#10;&#10;This experiment will consist of two types of task.&#10;&#10;The first task tests your memory. A series of letters will be presented on the screen, one at a time. Your job is to remember the letters. After each letter, your job is to determine whether it is the same as the letter that appeared a certain number of presentations back. We'll call this number N. So, if you see a letter &quot;A&quot; and the letter &quot;A&quot; also appeared N presentations back, you should respond &quot;same&quot;. If the letter N digits back was not &quot;A&quot;, you would not respond.&#10;&#10;In this experiment, N will be either 2 or 4. You will be told the N at the start of a block, and it will not change for that block.&#10;&#10;Let's do some practice!&#10;&#10;To move to the next screen, press spacebar." valType="str" updates="constant" plugin="None"/>
                <Param name="font" val="Open Sans" valType="str" updates="constant" plugin="None"/>
                <Param name="draggable" val="False" valType="code" updates="constant" plugin="None"/>
                <Param name="letterHeight" val="35" valType="num" updates="constant" plugin="None"/>
                <Param name="wrapWidth" val="1800" valType="num" updates="constant" plugin="None"/>
                <Param name="flip" val="None" valType="str" updates="constant" plugin="None"/>
                <Param name="languageStyle" val="LTR" valType="str" updates="None" plugin="None"/>
            </TextComponent>
