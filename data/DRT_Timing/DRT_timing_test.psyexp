                <Param name="contrast" val="1" valType="num" updates="constant" plugin="None"/>
                <Param name="validator" val="" valType="code" updates="None" plugin="None"/>
                <Param name="text" val="Great work!&#10;&#10;For the rest of the experiment, you will perform both the memory and the detection tasks together. At the beginning of each block, you will be told the level of N for the memory task and the stimulus you are responding to.&#10;&#10;Try to perform well on both tasks, remembering the sequence of letters while responding as quickly as possible to the detection task.&#10;&#10;You will do one final practice of the memory and detection tasks together, of N=2 then N=4.&#10;&#10;To move to the next screen, press spacebar." valType="str" updates="constant" plugin="None"/>
                <Param name="font" val="Open Sans" valType="str" updates="constant" plugin="None"/>
