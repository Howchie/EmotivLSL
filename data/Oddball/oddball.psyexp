                <Param name="registerOn" val="press" valType="str" updates="constant" plugin="None"/>
                <Param name="allowedKeys" val="'space'" valType="list" updates="constant" plugin="None"/>
                <Param name="store" val="last key" valType="str" updates="constant" plugin="None"/>
                <Param name="storeCorrect" val="True" valType="bool" updates="constant" plugin="None"/>
                <Param name="correctAns" val="$correct" valType="str" updates="constant" plugin="None"/>
                <Param name="saveStartStop" val="False" valType="bool" updates="None" plugin="None"/>
                <Param name="syncScreenRefresh" val="True" valType="bool" updates="constant" plugin="None"/>
                <Param name="disabled" val="False" valType="bool" updates="None" plugin="None"/>
                <Param name="discard previous" val="True" valType="bool" updates="constant" plugin="None"/>
            </KeyboardComponent>
        </Routine>
    </Routines>
    <Flow>
        <Routine name="Intro"/>
        <LoopInitiator name="eyes" plugin="None" loopType="TrialHandler">
            <Param name="name" val="eyes" valType="code" updates="None" plugin="None"/>
