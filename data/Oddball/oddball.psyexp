                <Param name="name" val="code" valType="code" updates="None" plugin="None"/>
                <Param name="Code Type" val="Auto-&gt;JS" valType="str" updates="None" plugin="None"/>
                <Param name="disabled" val="False" valType="bool" updates="None" plugin="None"/>
                <Param name="Before Experiment" val="" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="Begin Experiment" val="win.mouseVisible=False&#13;&#10;from pylsl import StreamInfo, StreamOutlet, local_clock&#13;&#10;import psychtoolbox as ptb&#13;&#10;from psychopy import sound&#13;&#10;import random as random&#13;&#10;import numpy as np&#13;&#10;# Create marker stream for Lab Streaming Layer&#13;&#10;info = StreamInfo(name='PsychoPy Markers', type='Markers', channel_count=1,nominal_srate=0, &#13;&#10;                  channel_format='string', source_id=expInfo['participant'])&#13;&#10;outlet = StreamOutlet(info)  # Broadcast the stream.&#13;&#10;mySound = sound.Sound(780,volume=1,stereo=False,secs=0.1)" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="Begin Routine" val="" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="Each Frame" val="" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="End Routine" val="" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="End Experiment" val="" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="Before JS Experiment" val="" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="Begin JS Experiment" val="import {StreamInfo, StreamOutlet, local_clock} from 'pylsl';&#10;import * as ptb from 'psychtoolbox';&#10;import {sound} from 'psychopy';&#10;import * as random from 'random';&#10;import * as np from 'numpy';&#10;psychoJS.window.mouseVisible = false;&#10;info = new StreamInfo({&quot;name&quot;: &quot;PsychoPy Markers&quot;, &quot;type&quot;: &quot;Markers&quot;, &quot;channel_count&quot;: 1, &quot;nominal_srate&quot;: 0, &quot;channel_format&quot;: &quot;string&quot;, &quot;source_id&quot;: expInfo[&quot;participant&quot;]});&#10;outlet = new StreamOutlet(info);&#10;mySound = new sound.Sound(780, {&quot;volume&quot;: 1, &quot;stereo&quot;: false, &quot;secs&quot;: 0.1});&#10;" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="Begin JS Routine" val="" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="Each JS Frame" val="" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="End JS Routine" val="" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="End JS Experiment" val="" valType="extendedCode" updates="constant" plugin="None"/>
            </CodeComponent>
            <TextComponent name="text6" plugin="None">
                <Param name="name" val="text6" valType="code" updates="None" plugin="None"/>
                <Param name="startVal" val="0" valType="code" updates="None" plugin="None"/>
                <Param name="startEstim" val="" valType="code" updates="None" plugin="None"/>
                <Param name="startType" val="time (s)" valType="str" updates="None" plugin="None"/>
                <Param name="stopVal" val="" valType="code" updates="constant" plugin="None"/>
                <Param name="durationEstim" val="" valType="code" updates="None" plugin="None"/>
                <Param name="stopType" val="duration (s)" valType="str" updates="None" plugin="None"/>
                <Param name="color" val="white" valType="color" updates="constant" plugin="None"/>
                <Param name="colorSpace" val="rgb" valType="str" updates="constant" plugin="None"/>
                <Param name="opacity" val="" valType="num" updates="constant" plugin="None"/>
                <Param name="pos" val="[0,0]" valType="list" updates="constant" plugin="None"/>
                <Param name="units" val="from exp settings" valType="str" updates="None" plugin="None"/>
                <Param name="ori" val="0" valType="num" updates="constant" plugin="None"/>
                <Param name="saveStartStop" val="False" valType="bool" updates="None" plugin="None"/>
                <Param name="syncScreenRefresh" val="False" valType="bool" updates="None" plugin="None"/>
                <Param name="disabled" val="False" valType="bool" updates="None" plugin="None"/>
                <Param name="contrast" val="1" valType="num" updates="constant" plugin="None"/>
                <Param name="validator" val="" valType="code" updates="None" plugin="None"/>
                <Param name="text" val="The following block requires you to discriminate between the two tones.&#10;&#10;When you heart the high pitch tone from the previous block, press 'space'.&#10;When you hear the low pitch tone from the previous block, do not press any button.&#10;&#10;Press space to begin." valType="str" updates="constant" plugin="None"/>
                <Param name="font" val="Arial" valType="str" updates="constant" plugin="None"/>
                <Param name="draggable" val="False" valType="code" updates="constant" plugin="None"/>
                <Param name="letterHeight" val="0.05" valType="num" updates="constant" plugin="None"/>
                <Param name="wrapWidth" val="" valType="num" updates="constant" plugin="None"/>
                <Param name="flip" val="None" valType="str" updates="constant" plugin="None"/>
                <Param name="languageStyle" val="LTR" valType="str" updates="None" plugin="None"/>
            </TextComponent>
            <KeyboardComponent name="key_resp" plugin="None">
                <Param name="name" val="key_resp" valType="code" updates="None" plugin="None"/>
