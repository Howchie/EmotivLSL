            <CodeComponent name="code2" plugin="None">
                <Param name="name" val="code2" valType="code" updates="None" plugin="None"/>
                <Param name="Code Type" val="Auto-&gt;JS" valType="str" updates="None" plugin="None"/>
                <Param name="disabled" val="False" valType="bool" updates="None" plugin="None"/>
                <Param name="Before Experiment" val="" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="Begin Experiment" val="" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="Begin Routine" val="isi = np.random.uniform(low=1.5,high=1.8)&#13;&#10;soa = np.random.uniform(low=.15,high=.5) &#13;&#10;&#13;&#10;tone_id, target_pa, target_lsl = audio.schedule_tone(&#13;&#10;    freq=freq,&#13;&#10;    delay=soa,&#13;&#10;    duration=0.100,&#13;&#10;    amplitude=1,&#13;&#10;    ramp_ms=5,&#13;&#10;    label=f&quot;GnG-{stim}&quot;&#13;&#10;)&#13;&#10;actual_onset = None&#13;&#10;schedule_error = None" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="Each Frame" val="for marker in audio.drain_markers(outlet):&#13;&#10;    if marker[&quot;id&quot;] == tone_id:&#13;&#10;        actual_onset = marker[&quot;lsl_time&quot;]&#13;&#10;        schedule_error = marker[&quot;error_s&quot;]&#13;&#10;        post = pcore.getTime()" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="End Routine" val="thisExp.addData(&quot;isi&quot;, isi)&#13;&#10;thisExp.addData(&quot;soa&quot;, soa)&#13;&#10;&#13;&#10;thisExp.addData(&quot;audio_target_lsl&quot;, target_lsl)&#13;&#10;thisExp.addData(&quot;audio_actual_lsl&quot;, actual_onset)&#13;&#10;&#13;&#10;if schedule_error is not None:&#13;&#10;    thisExp.addData(&#13;&#10;        &quot;audio_schedule_error_ms&quot;,&#13;&#10;        schedule_error * 1000&#13;&#10;    )" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="End Experiment" val="" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="Before JS Experiment" val="// Translating..." valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="Begin JS Experiment" val="// Translating..." valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="Begin JS Routine" val="// Translating..." valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="Each JS Frame" val="// Translating..." valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="End JS Routine" val="// Translating..." valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="End JS Experiment" val="// Translating..." valType="extendedCode" updates="constant" plugin="None"/>
            </CodeComponent>
