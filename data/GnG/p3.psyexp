            <Param name="Selected rows" val="" valType="code" updates="None" plugin="None"/>
            <Param name="random seed" val="" valType="code" updates="None" plugin="None"/>
            <Param name="conditions" val="[]" valType="str" updates="None" plugin="None"/>
            <Param name="endPoints" val="[0,1]" valType="code" updates="None" plugin="None"/>
        </LoopInitiator>
        <Routine name="sounds"/>
        <LoopTerminator name="trials"/>
        <LoopInitiator name="blocks" plugin="None" loopType="TrialHandler">
            <Param name="name" val="blocks" valType="code" updates="None" plugin="None"/>
            <Param name="loopType" val="sequential" valType="str" updates="None" plugin="None"/>
            <Param name="isTrials" val="False" valType="bool" updates="None" plugin="None"/>
            <Param name="conditionsFile" val="" valType="file" updates="None" plugin="None"/>
            <Param name="nReps" val="3" valType="code" updates="None" plugin="None"/>
            <Param name="Selected rows" val="" valType="code" updates="None" plugin="None"/>
            <Param name="random seed" val="" valType="code" updates="None" plugin="None"/>
            <Param name="conditions" val="[]" valType="str" updates="None" plugin="None"/>
            <Param name="endPoints" val="[0,1]" valType="code" updates="None" plugin="None"/>
        </LoopInitiator>
        <Routine name="ChoiceIntro"/>
        <LoopInitiator name="choice" plugin="None" loopType="TrialHandler">
            <Param name="name" val="choice" valType="code" updates="None" plugin="None"/>
            <Param name="loopType" val="random" valType="str" updates="None" plugin="None"/>
            <Param name="isTrials" val="True" valType="bool" updates="None" plugin="None"/>
            <Param name="conditionsFile" val="gng.xlsx" valType="file" updates="None" plugin="None"/>
            <Param name="nReps" val="20" valType="code" updates="None" plugin="None"/>
            <Param name="Selected rows" val="" valType="code" updates="None" plugin="None"/>
            <Param name="random seed" val="" valType="code" updates="None" plugin="None"/>
            <Param name="conditions" val="[]" valType="str" updates="None" plugin="None"/>
            <Param name="endPoints" val="[0,1]" valType="code" updates="None" plugin="None"/>
        </LoopInitiator>
        <Routine name="choice_trial"/>
        <LoopTerminator name="choice"/>
        <Routine name="Break"/>
        <LoopTerminator name="blocks"/>
        <LoopTerminator name="gng"/>
        <Routine name="End"/>
    </Flow>
</PsychoPy2experiment>