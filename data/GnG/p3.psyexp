                <Param name="allowedKeys" val="'space'" valType="list" updates="constant" plugin="None"/>
                <Param name="store" val="nothing" valType="str" updates="constant" plugin="None"/>
                <Param name="storeCorrect" val="False" valType="bool" updates="constant" plugin="None"/>
                <Param name="correctAns" val="" valType="str" updates="constant" plugin="None"/>
                <Param name="saveStartStop" val="False" valType="bool" updates="None" plugin="None"/>
                <Param name="syncScreenRefresh" val="False" valType="bool" updates="constant" plugin="None"/>
                <Param name="disabled" val="False" valType="bool" updates="None" plugin="None"/>
                <Param name="discard previous" val="False" valType="bool" updates="constant" plugin="None"/>
            </KeyboardComponent>
            <CodeComponent name="code_break" plugin="None">
                <Param name="name" val="code_break" valType="code" updates="None" plugin="None"/>
                <Param name="Code Type" val="Auto-&gt;JS" valType="str" updates="None" plugin="None"/>
                <Param name="disabled" val="False" valType="bool" updates="None" plugin="None"/>
                <Param name="Before Experiment" val="" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="Begin Experiment" val="" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="Begin Routine" val="outlet.push_sample([f&quot;BlockEnd-{blocks.thisN+1}&quot;],timestamp=local_clock())" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="Each Frame" val="" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="End Routine" val="" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="End Experiment" val="" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="Before JS Experiment" val="" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="Begin JS Experiment" val="" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="Begin JS Routine" val="outlet.push_sample([`BlockEnd-${(blocks.thisN + 1)}`], {&quot;timestamp&quot;: local_clock()});&#10;" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="Each JS Frame" val="" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="End JS Routine" val="" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="End JS Experiment" val="" valType="extendedCode" updates="constant" plugin="None"/>
            </CodeComponent>
        </Routine>
        <Routine name="sounds">
            <RoutineSettingsComponent name="sounds" plugin="None">
                <Param name="name" val="sounds" valType="code" updates="None" plugin="None"/>
                <Param name="stopVal" val="" valType="code" updates="constant" plugin="None"/>
                <Param name="durationEstim" val="" valType="code" updates="None" plugin="None"/>
                <Param name="stopType" val="duration (s)" valType="str" updates="None" plugin="None"/>
                <Param name="forceNonSlip" val="False" valType="code" updates="None" plugin="None"/>
                <Param name="skipIf" val="" valType="code" updates="constant" plugin="None"/>
                <Param name="useWindowParams" val="False" valType="bool" updates="None" plugin="None"/>
                <Param name="color" val="$[0,0,0]" valType="color" updates="None" plugin="None"/>
                <Param name="colorSpace" val="rgb" valType="str" updates="None" plugin="None"/>
                <Param name="backgroundImg" val="" valType="str" updates="None" plugin="None"/>
                <Param name="backgroundFit" val="none" valType="str" updates="None" plugin="None"/>
                <Param name="saveStartStop" val="False" valType="bool" updates="None" plugin="None"/>
                <Param name="disabled" val="False" valType="bool" updates="None" plugin="None"/>
                <Param name="desc" val="" valType="str" updates="constant" plugin="None"/>
            </RoutineSettingsComponent>
            <TextComponent name="text_sound" plugin="None">
                <Param name="name" val="text_sound" valType="code" updates="None" plugin="None"/>
                <Param name="startVal" val="0" valType="code" updates="None" plugin="None"/>
                <Param name="startEstim" val="" valType="code" updates="None" plugin="None"/>
                <Param name="startType" val="time (s)" valType="str" updates="None" plugin="None"/>
                <Param name="stopVal" val="1" valType="code" updates="constant" plugin="None"/>
                <Param name="durationEstim" val="" valType="code" updates="None" plugin="None"/>
                <Param name="stopType" val="duration (s)" valType="str" updates="None" plugin="None"/>
                <Param name="color" val="white" valType="color" updates="constant" plugin="None"/>
                <Param name="colorSpace" val="rgb" valType="str" updates="constant" plugin="None"/>
                <Param name="opacity" val="" valType="num" updates="constant" plugin="None"/>
                <Param name="pos" val="0,.2" valType="list" updates="constant" plugin="None"/>
                <Param name="units" val="from exp settings" valType="str" updates="None" plugin="None"/>
                <Param name="ori" val="0" valType="num" updates="constant" plugin="None"/>
                <Param name="saveStartStop" val="False" valType="bool" updates="None" plugin="None"/>
                <Param name="syncScreenRefresh" val="False" valType="bool" updates="None" plugin="None"/>
                <Param name="disabled" val="False" valType="bool" updates="None" plugin="None"/>
                <Param name="contrast" val="1" valType="num" updates="constant" plugin="None"/>
                <Param name="validator" val="" valType="code" updates="None" plugin="None"/>
                <Param name="text" val="$tone" valType="str" updates="set every repeat" plugin="None"/>
                <Param name="font" val="Arial" valType="str" updates="constant" plugin="None"/>
                <Param name="draggable" val="False" valType="code" updates="constant" plugin="None"/>
                <Param name="letterHeight" val="0.05" valType="num" updates="constant" plugin="None"/>
                <Param name="wrapWidth" val="" valType="num" updates="constant" plugin="None"/>
                <Param name="flip" val="None" valType="str" updates="constant" plugin="None"/>
                <Param name="languageStyle" val="LTR" valType="str" updates="None" plugin="None"/>
            </TextComponent>
            <TextComponent name="text_blank" plugin="None">
                <Param name="name" val="text_blank" valType="code" updates="None" plugin="None"/>
                <Param name="startVal" val="0" valType="code" updates="None" plugin="None"/>
                <Param name="startEstim" val="" valType="code" updates="None" plugin="None"/>
                <Param name="startType" val="time (s)" valType="str" updates="None" plugin="None"/>
                <Param name="stopVal" val="1" valType="code" updates="constant" plugin="None"/>
                <Param name="durationEstim" val="" valType="code" updates="None" plugin="None"/>
                <Param name="stopType" val="duration (s)" valType="str" updates="None" plugin="None"/>
                <Param name="color" val="white" valType="color" updates="constant" plugin="None"/>
                <Param name="colorSpace" val="rgb" valType="str" updates="constant" plugin="None"/>
                <Param name="opacity" val="" valType="num" updates="constant" plugin="None"/>
                <Param name="pos" val="[0,0]" valType="list" updates="constant" plugin="None"/>
                <Param name="units" val="from exp settings" valType="str" updates="None" plugin="None"/>
                <Param name="ori" val="0" valType="num" updates="constant" plugin="None"/>
                <Param name="saveStartStop" val="True" valType="bool" updates="None" plugin="None"/>
                <Param name="syncScreenRefresh" val="True" valType="bool" updates="None" plugin="None"/>
                <Param name="disabled" val="False" valType="bool" updates="None" plugin="None"/>
                <Param name="contrast" val="1" valType="num" updates="constant" plugin="None"/>
                <Param name="validator" val="" valType="code" updates="None" plugin="None"/>
                <Param name="text" val="Please listen to the tones as they cycle several times.&#10;One tone is high pitched, one is low-pitched." valType="str" updates="constant" plugin="None"/>
                <Param name="font" val="Arial" valType="str" updates="constant" plugin="None"/>
                <Param name="draggable" val="False" valType="code" updates="constant" plugin="None"/>
                <Param name="letterHeight" val="0.05" valType="num" updates="constant" plugin="None"/>
                <Param name="wrapWidth" val="" valType="num" updates="constant" plugin="None"/>
                <Param name="flip" val="None" valType="str" updates="constant" plugin="None"/>
                <Param name="languageStyle" val="LTR" valType="str" updates="None" plugin="None"/>
            </TextComponent>
            <CodeComponent name="code_example" plugin="None">
                <Param name="name" val="code_example" valType="code" updates="None" plugin="None"/>
                <Param name="Code Type" val="Auto-&gt;JS" valType="str" updates="None" plugin="None"/>
                <Param name="disabled" val="False" valType="bool" updates="None" plugin="None"/>
                <Param name="Before Experiment" val="" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="Begin Experiment" val="" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="Begin Routine" val="tone_id, target_pa, target_lsl = audio.schedule_tone(&#13;&#10;    freq=freq,&#13;&#10;    delay=0,&#13;&#10;    duration=0.100,&#13;&#10;    amplitude=1,&#13;&#10;    ramp_ms=5,&#13;&#10;    label=f&quot;example-{tone}&quot;&#13;&#10;)&#13;&#10;actual_onset = None&#13;&#10;schedule_error = None" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="Each Frame" val="for marker in audio.drain_markers(outlet):&#13;&#10;    if marker[&quot;id&quot;] == tone_id:&#13;&#10;        actual_onset = marker[&quot;lsl_time&quot;]&#13;&#10;        schedule_error = marker[&quot;error_s&quot;]&#13;&#10;        post = pcore.getTime()" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="End Routine" val="thisExp.addData(&quot;audio_target_lsl&quot;, target_lsl)&#13;&#10;thisExp.addData(&quot;audio_actual_lsl&quot;, actual_onset)&#13;&#10;&#13;&#10;if schedule_error is not None:&#13;&#10;    thisExp.addData(&#13;&#10;        &quot;audio_schedule_error_ms&quot;,&#13;&#10;        schedule_error * 1000&#13;&#10;    )" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="End Experiment" val="" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="Before JS Experiment" val="" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="Begin JS Experiment" val="" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="Begin JS Routine" val="[tone_id, target_pa, target_lsl] = audio.schedule_tone({&quot;freq&quot;: freq, &quot;delay&quot;: 0, &quot;duration&quot;: 0.1, &quot;amplitude&quot;: 1, &quot;ramp_ms&quot;: 5, &quot;label&quot;: `example-${tone}`});&#10;actual_onset = null;&#10;schedule_error = null;&#10;" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="Each JS Frame" val="for (var marker, _pj_c = 0, _pj_a = audio.drain_markers(outlet), _pj_b = _pj_a.length; (_pj_c &lt; _pj_b); _pj_c += 1) {&#10;    marker = _pj_a[_pj_c];&#10;    if ((marker[&quot;id&quot;] === tone_id)) {&#10;        actual_onset = marker[&quot;lsl_time&quot;];&#10;        schedule_error = marker[&quot;error_s&quot;];&#10;        post = pcore.getTime();&#10;    }&#10;}&#10;" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="End JS Routine" val="psychoJS.experiment.addData(&quot;audio_target_lsl&quot;, target_lsl);&#10;psychoJS.experiment.addData(&quot;audio_actual_lsl&quot;, actual_onset);&#10;if ((schedule_error !== null)) {&#10;    psychoJS.experiment.addData(&quot;audio_schedule_error_ms&quot;, (schedule_error * 1000));&#10;}&#10;" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="End JS Experiment" val="" valType="extendedCode" updates="constant" plugin="None"/>
            </CodeComponent>
        </Routine>
    </Routines>
    <Flow>
        <Routine name="Intro"/>
        <LoopInitiator name="eyes" plugin="None" loopType="TrialHandler">
            <Param name="name" val="eyes" valType="code" updates="None" plugin="None"/>
