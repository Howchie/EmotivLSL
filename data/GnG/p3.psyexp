            <CodeComponent name="intro_code" plugin="None">
                <Param name="name" val="intro_code" valType="code" updates="None" plugin="None"/>
                <Param name="Code Type" val="Auto-&gt;JS" valType="str" updates="None" plugin="None"/>
                <Param name="disabled" val="False" valType="bool" updates="None" plugin="None"/>
                <Param name="Before Experiment" val="" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="Begin Experiment" val="from psychopy import prefs&#13;&#10;from psychopy import core as pcore&#13;&#10;import sounddevice as sd&#13;&#10;import queue&#13;&#10;import itertools&#13;&#10;import numpy as np&#13;&#10;win.mouseVisible=False&#13;&#10;from pylsl import StreamInfo, StreamOutlet, local_clock&#13;&#10;import psychtoolbox as ptb&#13;&#10;from psychopy import sound&#13;&#10;import random as random&#13;&#10;prefs.hardware['audioLib'] = ['sounddevice']&#13;&#10;prefs.hardware['audioDevice'] = ['default']&#13;&#10;prefs.hardware['audioLatencyMode'] = '1'&#13;&#10;sd.default.samplerate = 48000&#13;&#10;&#13;&#10;class ScheduledAudio:&#13;&#10;    def __init__(&#13;&#10;        self,&#13;&#10;        samplerate=48000,&#13;&#10;        channels=2,&#13;&#10;        device=None,&#13;&#10;        latency=&quot;low&quot;&#13;&#10;    ):&#13;&#10;        self.fs = samplerate&#13;&#10;        self.channels = channels&#13;&#10;        # Main thread -&gt; audio callback&#13;&#10;        self._incoming = queue.SimpleQueue()&#13;&#10;        # Audio callback -&gt; main thread&#13;&#10;        self._markers = queue.SimpleQueue()&#13;&#10;        # Only touched by audio callback&#13;&#10;        self._events = []&#13;&#10;        self._ids = itertools.count()&#13;&#10;        self.stream = sd.OutputStream(&#13;&#10;            samplerate=self.fs,&#13;&#10;            channels=self.channels,&#13;&#10;            dtype=&quot;float32&quot;,&#13;&#10;            device=device,&#13;&#10;            latency=latency,&#13;&#10;            blocksize=0,       # let PortAudio choose optimal buffer size&#13;&#10;            callback=self._callback&#13;&#10;        )&#13;&#10;        self.stream.start()&#13;&#10;        # Work out relationship between PortAudio's clock and LSL's clock&#13;&#10;        self._lsl_minus_pa = self._calibrate_clocks()&#13;&#10;&#13;&#10;    def _calibrate_clocks(self, n=50):&#13;&#10;        &quot;&quot;&quot;&#13;&#10;        Estimate:&#13;&#10;            LSL time = PortAudio time + offset&#13;&#10;        &quot;&quot;&quot;&#13;&#10;        offsets = []&#13;&#10;        for _ in range(n):&#13;&#10;            # bracket stream.time to minimise sampling error&#13;&#10;            lsl1 = local_clock()&#13;&#10;            pa = float(self.stream.time)&#13;&#10;            lsl2 = local_clock()&#13;&#10;            lsl_mid = (lsl1 + lsl2) / 2&#13;&#10;            offsets.append(lsl_mid - pa)&#13;&#10;        return float(np.median(offsets))&#13;&#10;&#13;&#10;    def recalibrate(self):&#13;&#10;        &quot;&quot;&quot;&#13;&#10;        Fine to call occasionally between trials / blocks.&#13;&#10;        &quot;&quot;&quot;&#13;&#10;        self._lsl_minus_pa = self._calibrate_clocks()&#13;&#10;&#13;&#10;    def make_tone(&#13;&#10;        self,&#13;&#10;        freq,&#13;&#10;        duration=0.100,&#13;&#10;        amplitude=1,&#13;&#10;        ramp_ms=5&#13;&#10;    ):&#13;&#10;        &quot;&quot;&quot;&#13;&#10;        Generate tone in advance.&#13;&#10;        Nothing expensive happens in the audio callback.&#13;&#10;        &quot;&quot;&quot;&#13;&#10;        n = int(round(duration * self.fs))&#13;&#10;        t = np.arange(n, dtype=np.float64) / self.fs&#13;&#10;        wave = amplitude * np.sin(2 * np.pi * freq * t)&#13;&#10;&#13;&#10;        # raised-cosine-ish onset/offset ramp&#13;&#10;        ramp_n = int(round(ramp_ms / 1000 * self.fs))&#13;&#10;        ramp_n = min(ramp_n, n // 2)&#13;&#10;&#13;&#10;        if ramp_n &gt; 0:&#13;&#10;            x = np.linspace(0, np.pi / 2, ramp_n)&#13;&#10;            ramp = np.sin(x) ** 2&#13;&#10;            wave[:ramp_n] *= ramp&#13;&#10;            wave[-ramp_n:] *= ramp[::-1]&#13;&#10;        return wave.astype(np.float32)&#13;&#10;&#13;&#10;    def schedule_tone(&#13;&#10;        self,&#13;&#10;        freq,&#13;&#10;        delay,&#13;&#10;        duration=0.100,&#13;&#10;        amplitude=1,&#13;&#10;        ramp_ms=5,&#13;&#10;        label=None&#13;&#10;    ):&#13;&#10;        &quot;&quot;&quot;&#13;&#10;        Schedule a tone 'delay' seconds from NOW.&#13;&#10;&#13;&#10;        Returns:&#13;&#10;            event_id&#13;&#10;            requested onset in PortAudio time&#13;&#10;            requested onset in LSL time&#13;&#10;        &quot;&quot;&quot;&#13;&#10;        wave = self.make_tone(&#13;&#10;            freq=freq,&#13;&#10;            duration=duration,&#13;&#10;            amplitude=amplitude,&#13;&#10;            ramp_ms=ramp_ms&#13;&#10;        )&#13;&#10;        event_id = next(self._ids)&#13;&#10;        now_pa = float(self.stream.time)&#13;&#10;        target_pa = now_pa + delay&#13;&#10;        event = {&#13;&#10;            &quot;id&quot;: event_id,&#13;&#10;            &quot;label&quot;: label,&#13;&#10;            &quot;target_pa&quot;: target_pa,&#13;&#10;            &quot;wave&quot;: wave,&#13;&#10;            &quot;started&quot;: False,&#13;&#10;            &quot;pos&quot;: 0&#13;&#10;        }&#13;&#10;        self._incoming.put(event)&#13;&#10;        target_lsl = target_pa + self._lsl_minus_pa&#13;&#10;        return event_id, target_pa, target_lsl&#13;&#10;&#13;&#10;    def _callback(self, outdata, frames, time_info, status):&#13;&#10;        # normally output silence&#13;&#10;        outdata.fill(0)&#13;&#10;        # PortAudio's estimate of when SAMPLE ZERO of this&#13;&#10;        # buffer will hit the DAC&#13;&#10;        buffer_start_pa = float(time_info.outputBufferDacTime)&#13;&#10;        buffer_end_pa = (&#13;&#10;            buffer_start_pa&#13;&#10;            + frames / self.fs&#13;&#10;        )&#13;&#10;&#13;&#10;        # Grab anything the experiment thread scheduled&#13;&#10;        while True:&#13;&#10;            try:&#13;&#10;                event = self._incoming.get_nowait()&#13;&#10;                self._events.append(event)&#13;&#10;            except queue.Empty:&#13;&#10;                break&#13;&#10;&#13;&#10;        remaining_events = []&#13;&#10;        for event in self._events:&#13;&#10;            wave = event[&quot;wave&quot;]&#13;&#10;            # ----------------------------------------&#13;&#10;            # Event hasn't started yet&#13;&#10;            # ----------------------------------------&#13;&#10;            if not event[&quot;started&quot;]:&#13;&#10;                # Not in this buffer yet&#13;&#10;                if event[&quot;target_pa&quot;] &gt;= buffer_end_pa:&#13;&#10;                    remaining_events.append(event)&#13;&#10;                    continue&#13;&#10;                # Determine exact sample inside this buffer&#13;&#10;                start_frame = int(round(&#13;&#10;                    (event[&quot;target_pa&quot;] - buffer_start_pa)&#13;&#10;                    * self.fs&#13;&#10;                ))&#13;&#10;                # If scheduling arrived late, start ASAP&#13;&#10;                start_frame = max(0, start_frame)&#13;&#10;                if start_frame &gt;= frames:&#13;&#10;                    remaining_events.append(event)&#13;&#10;                    continue&#13;&#10;                actual_pa = (&#13;&#10;                    buffer_start_pa&#13;&#10;                    + start_frame / self.fs&#13;&#10;                )&#13;&#10;                event[&quot;started&quot;] = True&#13;&#10;                event[&quot;actual_pa&quot;] = actual_pa&#13;&#10;&#13;&#10;                # Tell main thread exactly where audio started&#13;&#10;                self._markers.put({&#13;&#10;                    &quot;id&quot;: event[&quot;id&quot;],&#13;&#10;                    &quot;label&quot;: event[&quot;label&quot;],&#13;&#10;                    &quot;target_pa&quot;: event[&quot;target_pa&quot;],&#13;&#10;                    &quot;actual_pa&quot;: actual_pa,&#13;&#10;                    &quot;error_s&quot;: actual_pa - event[&quot;target_pa&quot;]&#13;&#10;                })&#13;&#10;            else:&#13;&#10;                start_frame = 0&#13;&#10;            # ----------------------------------------&#13;&#10;            # Put waveform into output buffer&#13;&#10;            # ----------------------------------------&#13;&#10;&#13;&#10;            available = frames - start_frame&#13;&#10;            remaining_wave = len(wave) - event[&quot;pos&quot;]&#13;&#10;            n = min(available, remaining_wave)&#13;&#10;            if n &gt; 0:&#13;&#10;                segment = wave[&#13;&#10;                    event[&quot;pos&quot;]:&#13;&#10;                    event[&quot;pos&quot;] + n&#13;&#10;                ]&#13;&#10;                # same tone into every channel&#13;&#10;                outdata[&#13;&#10;                    start_frame:start_frame + n,&#13;&#10;                    :&#13;&#10;                ] += segment[:, None]&#13;&#10;                event[&quot;pos&quot;] += n&#13;&#10;            # Keep unfinished tones for next callback&#13;&#10;            if event[&quot;pos&quot;] &lt; len(wave):&#13;&#10;                remaining_events.append(event)&#13;&#10;&#13;&#10;        self._events = remaining_events&#13;&#10;        # safety if multiple sounds overlap&#13;&#10;        np.clip(outdata, -1.0, 1.0, out=outdata)&#13;&#10;&#13;&#10;    def drain_markers(self, outlet=None):&#13;&#10;        &quot;&quot;&quot;&#13;&#10;        Call this from PsychoPy's main thread every frame.&#13;&#10;&#13;&#10;        Returns events whose audio onset occurred since&#13;&#10;        the last call.&#13;&#10;&#13;&#10;        If outlet is supplied, also sends LSL marker&#13;&#10;        timestamped to estimated DAC onset.&#13;&#10;        &quot;&quot;&quot;&#13;&#10;&#13;&#10;        result = []&#13;&#10;        while True:&#13;&#10;            try:&#13;&#10;                marker = self._markers.get_nowait()&#13;&#10;            except queue.Empty:&#13;&#10;                break&#13;&#10;&#13;&#10;            marker[&quot;lsl_time&quot;] = (&#13;&#10;                marker[&quot;actual_pa&quot;]&#13;&#10;                + self._lsl_minus_pa&#13;&#10;            )&#13;&#10;&#13;&#10;            marker[&quot;target_lsl&quot;] = (&#13;&#10;                marker[&quot;target_pa&quot;]&#13;&#10;                + self._lsl_minus_pa&#13;&#10;            )&#13;&#10;&#13;&#10;            if outlet is not None and marker[&quot;label&quot;] is not None:&#13;&#10;                outlet.push_sample(&#13;&#10;                    [marker[&quot;label&quot;]],&#13;&#10;                    timestamp=marker[&quot;lsl_time&quot;]&#13;&#10;                )&#13;&#10;&#13;&#10;            result.append(marker)&#13;&#10;&#13;&#10;        return result&#13;&#10;&#13;&#10;    def close(self):&#13;&#10;        self.stream.stop()&#13;&#10;        self.stream.close()&#13;&#10;&#13;&#10;" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="Begin Routine" val="# Create marker stream for Lab Streaming Layer&#13;&#10;info = StreamInfo(name='PsychoPy Markers', type='Markers', channel_count=1,nominal_srate=0, &#13;&#10;                  channel_format='string', source_id=expInfo['participant'])&#13;&#10;outlet = StreamOutlet(info)  # Broadcast the stream.&#13;&#10;audio = ScheduledAudio(&#13;&#10;    samplerate=48000,&#13;&#10;    channels=2,&#13;&#10;    device=None&#13;&#10;)" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="Each Frame" val="" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="End Routine" val="" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="End Experiment" val="" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="Before JS Experiment" val="" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="Begin JS Experiment" val="// Error in Python code" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="Begin JS Routine" val="info = new StreamInfo({&quot;name&quot;: &quot;PsychoPy Markers&quot;, &quot;type&quot;: &quot;Markers&quot;, &quot;channel_count&quot;: 1, &quot;nominal_srate&quot;: 0, &quot;channel_format&quot;: &quot;string&quot;, &quot;source_id&quot;: expInfo[&quot;participant&quot;]});&#10;outlet = new StreamOutlet(info);&#10;audio = new ScheduledAudio({&quot;samplerate&quot;: 48000, &quot;channels&quot;: 2, &quot;device&quot;: null});&#10;" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="Each JS Frame" val="" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="End JS Routine" val="" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="End JS Experiment" val="" valType="extendedCode" updates="constant" plugin="None"/>
            </CodeComponent>
